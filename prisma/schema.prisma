generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Model untuk Pengguna (Super Admin & Admin Satker)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nama      String
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: Seorang Admin Satker mengelola satu Satker
  satker   Satker? @relation(fields: [satkerId], references: [id], onDelete: SetNull)
  satkerId String? @unique
}

model Satker {
  id                    String                  @id @default(cuid())
  kode                  String                  @unique
  nama                  String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  admin                 User?
  personil              Personil[]
  ht                    HT[]
  peminjamanOlehSatker  PeminjamanSatker[]
  pengajuanPeminjaman   PengajuanPeminjaman[]
  pengajuanMutasiAsal   PengajuanMutasi[]       @relation("SatkerAsal")
  pengajuanMutasiTujuan PengajuanMutasi[]       @relation("SatkerTujuan")
  pengajuanPengembalian PengajuanPengembalian[] // Updated relation
}

model Personil {
  id              String            @id @default(cuid())
  nrp             String            @unique
  nama            String
  jabatan         String
  pangkat         String
  fotoUrl         String?
  subSatker       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  satker          Satker            @relation(fields: [satkerId], references: [id], onDelete: Cascade)
  satkerId        String
  peminjaman      Peminjaman[]
  pengajuanMutasi PengajuanMutasi[]
}

model HT {
  id                   String                  @id @default(cuid())
  serialNumber         String                  @unique
  merk                 String
  jenis                String
  tahunBuat            Int
  tahunPeroleh         Int
  status               HTStatus                @default(BAIK)
  catatanKondisi       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  satker               Satker?                 @relation(fields: [satkerId], references: [id])
  satkerId             String?

  peminjaman           Peminjaman[]
  peminjamanOlehSatker PeminjamanSatker[]
  pengembalianDetails  PengembalianDetail[]    // Updated relation

  @@map("HT")
}

// --- MODEL TRANSAKSI & PENGAJUAN ---

model Peminjaman {
  id                    String                @id @default(cuid())
  tanggalPinjam         DateTime              @default(now())
  estimasiKembali       DateTime?
  tanggalKembali        DateTime?
  kondisiSaatPinjam     String
  kondisiSaatKembali    String?
  kondisiHTSaatPinjam   HTStatus?             // Kondisi HT saat dipinjam
  kondisiHTSaatKembali  HTStatus?             // Kondisi HT saat dikembalikan
  catatan               String?
  fileUrl               String?
  adminPencatatId       String
  ht                    HT                    @relation(fields: [htId], references: [id], onDelete: Cascade)
  htId                  String
  personil              Personil              @relation(fields: [personilId], references: [id], onDelete: Cascade)
  personilId            String
  riwayatPerpanjangan   RiwayatPerpanjangan[]
}

model RiwayatPerpanjangan {
  id                    String    @id @default(cuid())
  peminjamanId          String
  estimasiKembaliLama   DateTime?
  estimasiKembaliBaru   DateTime
  fileUrlLama           String?
  fileUrlBaru           String?
  catatan               String?
  adminPencatatId       String
  createdAt             DateTime  @default(now())
  
  peminjaman            Peminjaman @relation(fields: [peminjamanId], references: [id], onDelete: Cascade)
  
  @@index([peminjamanId])
  @@index([createdAt])
}

model PeminjamanSatker {
  id             String    @id @default(cuid())
  tanggalPinjam  DateTime  @default(now())
  tanggalKembali DateTime?
  catatan        String?
  ht             HT        @relation(fields: [htId], references: [id], onDelete: Cascade)
  htId           String
  satker         Satker    @relation(fields: [satkerId], references: [id], onDelete: Cascade)
  satkerId       String
}

model PengajuanPeminjaman {
  id            String          @id @default(cuid())
  keperluan     String
  tanggalMulai    DateTime?
  tanggalSelesai  DateTime?
  jumlah        Int
  fileUrl       String?
  status        PengajuanStatus @default(PENDING)
  trackingStatus TrackingStatus @default(PENGAJUAN_DIKIRIM)
  catatanAdmin  String?
  estimasiSelesai DateTime?
  tanggalPickup DateTime?
  tanggalReturn DateTime?
  
  // Timestamp untuk setiap tahap proses
  tanggalDikirim      DateTime?  @default(now())
  tanggalSedangProses DateTime?
  tanggalDisetujui    DateTime?
  tanggalSiapDiambil  DateTime?
  tanggalSedangDigunakan DateTime?
  tanggalPermintaanKembali DateTime?
  tanggalSudahDikembalikan DateTime?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  satkerPengaju Satker          @relation(fields: [satkerId], references: [id], onDelete: Cascade)
  satkerId      String
}

model PengajuanMutasi {
  id             String          @id @default(cuid())
  alasan         String
  fileUrl        String?
  status         PengajuanStatus @default(PENDING)
  catatanAdmin   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  personil       Personil        @relation(fields: [personilId], references: [id])
  personilId     String
  satkerAsal     Satker          @relation("SatkerAsal", fields: [satkerAsalId], references: [id])
  satkerAsalId   String
  satkerTujuan   Satker          @relation("SatkerTujuan", fields: [satkerTujuanId], references: [id])
  satkerTujuanId String
}

// --- MODEL BARU ---
model PengajuanPengembalian {
  id                     String                    @id @default(cuid())
  alasan                 String
  status                 PengajuanStatus           @default(PENDING)
  catatanAdmin           String?
  pengajuanPeminjamanId  String?                   // Link to original loan request
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  satkerPengaju          Satker                    @relation(fields: [satkerId], references: [id])
  satkerId               String

  // One-to-many relationship for package returns
  pengembalianDetails    PengembalianDetail[]

  @@index([satkerId])
  @@index([pengajuanPeminjamanId])
}

// Detail table for package returns
model PengembalianDetail {
  id                     String                 @id @default(cuid())
  pengajuanPengembalian  PengajuanPengembalian  @relation(fields: [pengajuanPengembalianId], references: [id], onDelete: Cascade)
  pengajuanPengembalianId String
  ht                     HT                     @relation(fields: [htId], references: [id])
  htId                   String
  createdAt              DateTime               @default(now())

  @@index([pengajuanPengembalianId])
  @@index([htId])
}


// --- ENUMS ---
enum Role {
  SUPER_ADMIN
  ADMIN_SATKER
}

enum HTStatus {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
  HILANG
}

enum PengajuanStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TrackingStatus {
  PENGAJUAN_DIKIRIM
  SEDANG_DIPROSES
  DISETUJUI
  SIAP_DIAMBIL
  SEDANG_DIGUNAKAN
  PERMINTAAN_PENGEMBALIAN
  SUDAH_DIKEMBALIKAN
  DITOLAK
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  type         String
  title        String
  message      String
  link         String?  // URL tujuan saat notifikasi diklik
  relatedId    String?
  satkerName   String?
  priority     String   @default("medium")
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  
  @@index([userId, isRead])
  @@index([createdAt])
}
